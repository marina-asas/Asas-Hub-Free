local refreshLoop = task.spawn(function()
    while ScreenGui.Parent and not MenuState.closed do
        refreshAllLists()
        task.wait(2)
    end
end)

local function DoTeleport()
    local target = tpSelected
    -- If no one is selected in the UI, fall back to nearest valid target
    if not target then
        local targets = Teleport.GetTargets()
        if #targets > 0 then
            target = targets[1].player
        end
    end

    if not target then
        TPButton.Text = "NO TARGET FOUND"
        task.wait(1.2); TPButton.Text = "TELEPORT [K]"; return
    end
    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        TPButton.Text = "PLAYER HAS NO CHARACTER"
        task.wait(1.2); TPButton.Text = "TELEPORT [K]"; return
    end

    TPButton.Text = "TELEPORTING..."
    TPButton.BackgroundColor3 = Color3.fromRGB(200, 160, 60)
    local ok = Teleport.GoTo(target)
    if ok then
        TPButton.Text = "TELEPORTED TO " .. target.Name
        TPButton.BackgroundColor3 = Color3.fromRGB(80, 160, 90)
    else
        TPButton.Text = "TELEPORT FAILED"
        TPButton.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    end
    task.wait(1.5); TPButton.Text = "TELEPORT [K]"
    TPButton.BackgroundColor3 = Color3.fromRGB(80, 160, 90)
end

TPButton.MouseButton1Click:Connect(DoTeleport)

