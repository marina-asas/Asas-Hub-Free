local function makeStepper(label, initial, min, max, step, order, onchange)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 32)
    holder.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
    holder.LayoutOrder = order
    holder.Parent = UniversalPage
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -110, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label .. ": " .. string.format("%.2f", initial)
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = holder

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0, 28, 0, 24)
    minus.Position = UDim2.new(1, -94, 0, 4)
    minus.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    minus.Text = "−"
    minus.TextColor3 = Color3.fromRGB(240, 240, 250)
    minus.TextSize = 14
    minus.Font = Enum.Font.GothamBold
    minus.AutoButtonColor = false
    minus.Parent = holder
    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0, 28, 0, 24)
    plus.Position = UDim2.new(1, -60, 0, 4)
    plus.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    plus.Text = "+"
    plus.TextColor3 = Color3.fromRGB(240, 240, 250)
    plus.TextSize = 14
    plus.Font = Enum.Font.GothamBold
    plus.AutoButtonColor = false
    plus.Parent = holder
    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)

    local val = initial
    local function set(nv)
        val = math.clamp(nv, min, max)
        lbl.Text = label .. ": " .. string.format("%.2f", val)
        onchange(val)
    end
    set(val)
    minus.MouseButton1Click:Connect(function() set(val - step) end)
    plus.MouseButton1Click:Connect(function() set(val + step) end)
end

makeStepper("Interval (s)", Rage.Interval, 0.05, 5, 0.05, 11, function(v) Rage.Interval = v end)
