-- ========== WHITELIST ==========
local Whitelist = {}
Whitelist._set = {}
function Whitelist.Add(name)
    name = tostring(name); if name == "" then return end
    Whitelist._set[name:lower()] = name
end
function Whitelist.Remove(name) Whitelist._set[tostring(name):lower()] = nil end
function Whitelist.Has(plr)
    if type(plr) == "string" then return Whitelist._set[plr:lower()] ~= nil end
    return Whitelist._set[plr.Name:lower()] ~= nil
end
function Whitelist.List()
    local a = {}; for _, n in pairs(Whitelist._set) do table.insert(a, n) end
    table.sort(a); return a
end

-- ========== HITBOX ==========
local Hitbox = {}
Hitbox.Enabled = false; Hitbox.Size = 5; Hitbox.SKIP_TEAM = true
Hitbox._originals = {}; Hitbox._conn = nil
local function isTeamExcluded(plr)
    if plr == LocalPlayer then return true end
    if not Hitbox.SKIP_TEAM then return false end
    if LocalPlayer.Team and plr.Team then return LocalPlayer.Team == plr.Team end
    return false
end
local function applyHitbox(model, size)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            local n = part.Name
            if n == "HumanoidRootPart" or n == "Torso" or n == "UpperTorso"
               or n == "LowerTorso" or n == "Hitbox" or n == "RootPart" then
                if not Hitbox._originals[part] then
                    Hitbox._originals[part] = { size = part.Size, massless = part.Massless, trans = part.Transparency }
                end
                local o = Hitbox._originals[part].size
                part.Size = Vector3.new(math.max(o.X, size), math.max(o.Y, size), math.max(o.Z, size))
                part.Massless = true; part.CanCollide = false; part.Transparency = 0.7
            end
        end
    end
end
local function restoreHitbox(model)
    for _, part in ipairs(model:GetDescendants()) do
        local o = Hitbox._originals[part]
        if o then
            part.Size = o.size; part.Massless = o.massless; part.Transparency = o.trans
            part.CanCollide = true; Hitbox._originals[part] = nil
        end
    end
end
function Hitbox.Start()
    if Hitbox.Enabled then return end
    Hitbox.Enabled = true
    Hitbox._conn = RunService.Heartbeat:Connect(function()
        if not Hitbox.Enabled then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            local char = plr.Character
            if isTeamExcluded(plr) or Whitelist.Has(plr) then
                if char then restoreHitbox(char) end
            elseif char and char:FindFirstChildOfClass("Humanoid") then
                applyHitbox(char, Hitbox.Size)
            end
        end
    end)
end
function Hitbox.Stop()
    Hitbox.Enabled = false
    if Hitbox._conn then Hitbox._conn:Disconnect(); Hitbox._conn = nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then restoreHitbox(plr.Character) end
    end
end
function Hitbox.SetSize(n) Hitbox.Size = math.clamp(n, 2, 30) end

-- ========== RAGE ==========
local Rage = {}
Rage.Enabled = false; Rage.Interval = 0.4; Rage.BehindDuration = 0.8
Rage.Distance = 3; Rage.UseTeams = true
Rage._conn = nil; Rage._nextRun = 0; Rage._pinning = false
local function candidateTargets()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local teamOK = true
                if Rage.UseTeams and LocalPlayer.Team and plr.Team then
                    teamOK = plr.Team ~= LocalPlayer.Team
                end
                if teamOK and not Whitelist.Has(plr) then table.insert(list, plr) end
            end
        end
    end
    return list
end
local function behindCFrame(targetHRP)
    return targetHRP.CFrame * CFrame.new(0, 0, Rage.Distance)
end
local function doRageTick()
    if not Rage.Enabled or Rage._pinning then return end
    local targets = candidateTargets()
    if #targets == 0 then return end
    local target = targets[math.random(1, #targets)]
    local myChar = LocalPlayer.Character; if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
    local targetHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end
    Rage._pinning = true
    local pinTarget = target
    local pinEnd = tick() + Rage.BehindDuration
    local pinConn
    pinConn = RunService.Heartbeat:Connect(function()
        if not Rage.Enabled or tick() >= pinEnd then
            Rage._pinning = false; pinConn:Disconnect(); return
        end
        local c = LocalPlayer.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        local thrp = pinTarget.Character and pinTarget.Character:FindFirstChild("HumanoidRootPart")
        if hrp and thrp then hrp.CFrame = behindCFrame(thrp) end
    end)
end
function Rage.Start()
    if Rage.Enabled then return end
    Rage.Enabled = true; Rage._nextRun = tick()
    Rage._conn = RunService.Heartbeat:Connect(function()
        if not Rage.Enabled then return end
        if tick() >= Rage._nextRun then
            Rage._nextRun = tick() + Rage.Interval
            doRageTick()
        end
    end)
end
function Rage.Stop()
    Rage.Enabled = false; Rage._pinning = false
    if Rage._conn then Rage._conn:Disconnect(); Rage._conn = nil end
end

-- ========== TELEPORT ==========
local Teleport = {}
Teleport._pinConn = nil
function Teleport.GetTargets()
    local list = {}
    local myChar = LocalPlayer.Character
    local myPos = myChar and myChar:FindFirstChild("HumanoidRootPart")
        and myChar.HumanoidRootPart.Position or Vector3.zero
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                table.insert(list, {
                    player = plr,
                    distance = (hrp.Position - myPos).Magnitude,
                })
            end
        end
    end
    table.sort(list, function(a, b) return a.distance < b.distance end)
    return list
end
function Teleport.GoTo(plr)
    if not plr or plr == LocalPlayer then return false end
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false end
    local targetHRP = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return false end
    myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
    return true
end

