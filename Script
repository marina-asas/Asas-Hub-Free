local function ToggleRage()
    if Rage.Enabled then
        Rage.Stop()
        RageToggle.Text = "Classic Rage: OFF [Y]"
        RageToggle.BackgroundColor3 = Color3.fromRGB(60, 50, 110)
    else
        Rage.Start()
        RageToggle.Text = "Classic Rage: ON [Y]"
        RageToggle.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    end
end

