local function refreshWhitelistList()
    for _, c in ipairs(WLScroll:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    local players = Players:GetPlayers()
    table.sort(players, function(a, b) return a.Name:lower() < b.Name:lower() end)
    for i, plr in ipairs(players) do
        if plr ~= LocalPlayer then
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, -8, 0, 32)
            row.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
            row.Text = "  [ ] " .. plr.Name
            row.TextColor3 = Color3.fromRGB(220, 220, 235)
            row.TextSize = 12
            row.Font = Enum.Font.Gotham
            row.TextXAlignment = Enum.TextXAlignment.Left
            row.AutoButtonColor = false
            row.LayoutOrder = i
            row.Parent = WLScroll
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

            if Whitelist.Has(plr) then
                row.BackgroundColor3 = Color3.fromRGB(60, 50, 110)
                row.TextColor3 = Color3.fromRGB(255, 255, 255)
                row.Text = "  [x] " .. plr.Name
            end

            row.MouseButton1Click:Connect(function()
                if Whitelist.Has(plr) then Whitelist.Remove(plr.Name)
                else Whitelist.Add(plr.Name) end
                refreshWhitelistList()
            end)
        end
    end
    WLScroll.CanvasSize = UDim2.new(0, 0, 0, math.max((#players - 1) * 36, 4))
end

