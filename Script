local ExpandedHeight = 64 + 30 + 12 + 6 + 330 + 24
local function SetOpen(state)
    MenuState.open = state
    TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 440, 0, state and ExpandedHeight or 60),
    }):Play()
    ToggleBtn.Text = state and "▴" or "▾"
    TabBar.Visible = state
    Body.Visible = state
end
Body.Visible = false
TabBar.Visible = false
ToggleBtn.MouseButton1Click:Connect(function() SetOpen(not MenuState.open) end)
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then SetOpen(not MenuState.open) end
end)

local function SetMinimized(state)
    if MenuState.closed then return end
    MenuState.minimized = state
    if state then
        SetOpen(false)
        TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quart), {
            Size = UDim2.new(0, 140, 0, 36),
        }):Play()
        TitleBar.Visible = true
        Title.Text = "Rivals"
        SubTitle.Visible = false
        MinimizeBtn.Visible = false
        CloseBtn.Visible = false
        ToggleBtn.Text = "▢"
        ToggleBtn.Position = UDim2.new(1, -36, 0, 4)
        TitleBar.Size = UDim2.new(1, 0, 0, 36)
        Title.Position = UDim2.new(0, 12, 0, 8)
        Title.Size = UDim2.new(1, -50, 0, 20)
    else
        TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quart), {
            Size = UDim2.new(0, 440, 0, 60),
        }):Play()
        TitleBar.Size = UDim2.new(1, 0, 0, 60)
        Title.Text = "Rivals • Script Menu"
        Title.Position = UDim2.new(0, 14, 0, 8)
        Title.Size = UDim2.new(1, -140, 0, 30)
        SubTitle.Visible = true
        MinimizeBtn.Visible = true
        CloseBtn.Visible = true
        ToggleBtn.Text = "▾"
        ToggleBtn.Position = UDim2.new(1, -36, 0, 16)
    end
end
MinimizeBtn.MouseButton1Click:Connect(function() SetMinimized(true) end)
ToggleBtn.MouseButton1Click:Connect(function()
    if MenuState.minimized then SetMinimized(false) end
end)

local function CloseMenu()
    if MenuState.closed then return end
    MenuState.closed = true
    pcall(function() Hitbox.Stop() end)
    pcall(function() Rage.Stop() end)
    if refreshLoop and coroutine.status(refreshLoop) ~= "dead" then
        pcall(function() task.cancel(refreshLoop) end)
    end
    ScreenGui:Destroy()
    print("[Rivals Menu] closed")
end
CloseBtn.MouseButton1Click:Connect(CloseMenu)

-- ========== DRAG ==========
do
    local dragging, dragStart, startPos
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = Main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                      startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

